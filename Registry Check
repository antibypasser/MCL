$roots = @(
    "HKLM:\SOFTWARE\Microsoft\Windows Defender\Threats",
    "HKLM:\SOFTWARE\Microsoft\Windows Defender\Exclusions"
)

function Get-KeyName {
    param([string]$Path)
    return ($Path -split '\\')[-1]
}

function Check-Key {
    param([string]$Path)

    $name = Get-KeyName $Path

    if (-not (Test-Path $Path)) {
        Write-Host "$name -> NOT FOUND ❌"
        return
    }

    try {
        $props = Get-ItemProperty $Path -ErrorAction Stop

        $values = $props.PSObject.Properties |
            Where-Object { $_.Name -notlike "PS*" }

        $valueText = if ($values.Count -gt 0) {
            ($values | ForEach-Object { "$($_.Name)=$($_.Value)" }) -join ", "
        } else {
            "empty"
        }

        $nonDefault = $values | Where-Object { $_.Name -ne "(default)" }

        if ($nonDefault.Count -eq 0) {
            Write-Host "$name -> OK ✔ [$valueText]" -ForegroundColor Green
        } else {
            Write-Host "$name -> NOT OK ❌ [$valueText]" -ForegroundColor Red
        }

    } catch {
        Write-Host "$name -> NOT OK ❌ [unreadable]" -ForegroundColor Red
    }
}

foreach ($root in $roots) {

    Check-Key $root

    if (Test-Path $root) {
        Get-ChildItem $root -Recurse -ErrorAction SilentlyContinue | ForEach-Object {
            Check-Key $_.PSPath
        }
    }
}
